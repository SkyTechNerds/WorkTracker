{
  "name": "worktracker",
  "version": "0.2.0",
  "description": "Cross-platform Arbeitszeit-Tracker (Mac + Windows)",
  "main": "./out/main/index.js",
  "author": "SkyTechNerds",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "package:all": "electron-vite build && electron-builder --mac --win"
  },
  "build": {
    "appId": "com.skytechnerds.worktracker",
    "productName": "WorkTracker",
    "afterPack": "build/afterPack.cjs",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["out/**/*", "package.json"],
    "publish": [{ "provider": "github", "owner": "SkyTechNerds", "repo": "WorkTracker" }],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": "arm64" }],
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": { "LSUIElement": true }
    },
    "dmg": { "title": "WorkTracker ${version}" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WorkTracker"
    }
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "dependencies": {
    "mqtt": "^5.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  }
}
